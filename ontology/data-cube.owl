@prefix edintgast: <https://edint.es/def/cubo-gasto-comercial#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix qb:       <http://purl.org/linked-data/cube#> .
@prefix sdmx-dimension:  <http://purl.org/linked-data/sdmx/2009/dimension#> .
@prefix sdmx-measure:    <http://purl.org/linked-data/sdmx/2009/measure#> .
@prefix pubsec: <https://datos.gob.es/kos/sector-publico/sector#>.
@prefix dcterms:      <http://purl.org/dc/terms/> .
@prefix vann:         <http://purl.org/vocab/vann/> .
@prefix esadm:    <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#> .
@prefix time:     <http://www.w3.org/2006/time#> .
@prefix edintdimension: <http://vocab.linkeddata.es/datosabiertos/def/dimension#> .
@prefix edintmeasure: <http://vocab.linkeddata.es/datosabiertos/def/measure#> .
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .

# -- Data Set --------------------------------------------

<https://edint.es/def/cubo-gasto-comercial> a qb:DataSet, owl:Ontology ; 
    owl:versionIRI <https://edint.es/def/cubo-gasto-comercial/0.2.1> ;
    owl:imports <http://purl.org/linked-data/cube> ;
    dcterms:creator [ foaf:name "Daniel Doña" ; schema:affiliation <https://oeg.fi.upm.es/> ],
                  [ foaf:name "Edna Ruckhaus" ; schema:affiliation <https://oeg.fi.upm.es/> ],
                  [ foaf:name "Lucía Sánchez" ; schema:affiliation <https://oeg.fi.upm.es/> ],
                  [ foaf:name "Oscar Corcho" ; schema:affiliation <https://oeg.fi.upm.es/> ],
                  [ foaf:name "Socorro Bernardos" ; schema:affiliation <https://oeg.fi.upm.es/> ],
                  [ foaf:name "Diego Conde" ; schema:affiliation <https://oeg.fi.upm.es/> ] ;
    dcterms:title "Cubo de Datos EDINT de Gasto Comercial"@es  ;
    dcterms:title "EDINT Commercial Expenditure Data Cube"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespaceUri <https://edint.es/def/cubo-gasto-comercial#> ;
    vann:preferredNamespacePrefix "edintgast" ;
    owl:versionInfo "0.2.1" ;
    dcterms:created "2026-04-20"^^xsd:date ;
    dcterms:issued  "2026-09-17"^^xsd:date ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:subject
        pubsec:comercio ,
        pubsec:economia ;
    qb:structure edintgast:dsd  ;
    owl:priorVersion <https://github.com/EDINT-Ontologia/edint-cubo-gasto-comercial/releases/tag/v0.2.0> ;
    schema:codeRepository <https://github.com/EDINT-Ontologia/edint-cubo-gasto-comercial> ;
    dcterms:publisher [ foaf:name "FEMP" ; foaf:homepage <https://www.femp.es/> ; schema:affiliation "Federación Española de Municipios y Provincias" ] ;
    dcterms:bibliographicCitation """Cubo de Datos EDINT de Gasto Comercial. EDINT. Revision: v0.2.1."""@es ;
    dcterms:bibliographicCitation """EDINT Commercial Expenditure Data Cube. EDINT. Revision: v0.2.1."""@en ;
    schema:creativeWorkStatus "Ontology Specification"@en ;
    dcterms:abstract
        """
El propósito de este vocabulario es proporcionar la definición de la estructura del cubo de datos de gasto comercial. Para ello, se reutiliza el vocabulario W3C Data Cube y se han creado las instancias necesarias para definir dicha estructura, indicando las dimensiones y medidas utilizadas en este cubo.

Además, se reutilizan varios vocabularios y listas de códigos para describir los diferentes desgloses de la información sobre gasto comercial, como el territorio, el periodo de referencia, el sector de actividad económica y la nacionalidad.
"""@es,
        """
The purpose of this vocabulary is to provide the definition of the structure of the commercial expenditure data cube. To this end, the W3C Data Cube vocabulary is reused, and the necessary instances have been created to define such structure, indicating the dimensions and measures used in this cube.

Additionally, several vocabularies and code lists are reused to describe the different breakdowns of commercial expenditure information, such as territory, reference period, economic activity sector, and nationality.
"""@en  .

edintgast:dsd a qb:DataStructureDefinition;
     qb:component
        [ qb:dimension edintdimension:refAdminRegion ; qb:order 1 ] ,
        [ qb:dimension edintdimension:sector ; qb:order 2] ,
        [ qb:dimension edintdimension:economicActivity ; qb:order 3 ] ,
        [ qb:dimension edintdimension:refPeriod ; qb:order 4] ,
        [ qb:dimension edintdimension:nationality ; qb:order 5] ,
        [ qb:measure edintmeasure:expenditureAmount ; qb:order 6] .


edintdimension:refAdminRegion
    a qb:DimensionProperty ;
    rdfs:label "Reference Administrative Region"@en, "Región Administrativa de Referencia"@es ;
    rdfs:comment "Administrative region associated."@en, "Región administrativa asociada."@es ;
    rdfs:subPropertyOf sdmx-dimension:refArea ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf ( esadm:Municipio esadm:Barrio esadm:Distrito )
    ] .

edintdimension:refPeriod  a qb:DimensionProperty ;
    rdfs:label "Reference Period"@en, "Periodo de Referencia"@es ;
    rdfs:comment "Period of time or point in time to which the measured observation is intended to refer."@en, "Período de tiempo o punto en el tiempo al que se destina la observación medida."@es ;
    rdfs:subPropertyOf sdmx-dimension:refPeriod ;
    rdfs:range time:Interval .

edintdimension:sector
    rdf:type qb:DimensionProperty ,
    qb:CodedProperty ;
    rdfs:label "Sector"@es ,
        "Sector"@en ;
    rdfs:comment "Sector temático asociado a la observación de empleo."@es ,
        "Thematic sector associated with the employment observation."@en ;
    rdfs:range skos:Concept ;
    qb:codeList <http://datos.gob.es/kos/sector-publico/sector> .

edintdimension:economicActivity
    rdf:type qb:DimensionProperty ,
    qb:CodedProperty ;
    rdfs:label "Actividad económica"@es ,
    "Economic activity"@en ;
    rdfs:comment "Actividad económica representada mediante una clasificación controlada como la CNAE."@es ,
    "Economic activity represented using a controlled classification such as CNAE."@en ;
    rdfs:range skos:Concept ;
    qb:codeList <http://lod.ine.es/kos/cnae/CNAE-2025>  .

edintdimension:nationality a qb:DimensionProperty  ;
    rdfs:range rdfs:Resource;
    rdfs:label "Nacionalidad"@es, "Nationality"@en ; ;
    rdfs:comment "Nacionalidad de los sujetos de la estadística."@es, "Nationality of the statistical subjects."@en .

edintmeasure:expenditureAmount  a qb:MeasureProperty;
    rdfs:label "Importe del Gasto"@es, "Expenditure Amount"@en ;
    rdfs:comment "Cantidad monetaria total del gasto realizado en un contexto determinado"@es, "Total monetary amount of expenditure made in a given context."@en ;
    rdfs:subPropertyOf sdmx-measure:obsValue;
    rdfs:range xsd:decimal .

<https://oeg.fi.upm.es/> a foaf:Organization ; foaf:name "Ontology Engineering Group, UPM" .
@prefix widoco: <https://w3id.org/widoco/vocab#> .

# -- Nombres de fichero de las serializaciones (vocabulario Widoco) --
<https://edint.es/def/cubo-gasto-comercial> widoco:rdfxmlSerialization "ontology.rdf" ;
    widoco:turtleSerialization "ontology.ttl" ;
    widoco:ntSerialization "ontology.nt" ;
    widoco:jsonldSerialization "ontology.jsonld" .
# -- Etiquetas de vocabularios (vocabulario Widoco) --
<https://edint.es/def/cubo-gasto-comercial> widoco:vocabularyLabel [
    widoco:vocabularyIRI <http://purl.org/linked-data/cube> ;
    rdfs:label "W3C Data Cube"@es , "W3C Data Cube"@en ] .
<https://edint.es/def/cubo-gasto-comercial> widoco:vocabularyLabel [
    widoco:vocabularyIRI <http://vocab.linkeddata.es/datosabiertos/def/dimension> ;
    rdfs:label "Dimensiones EDINT"@es , "EDINT Dimensions"@en ] .
<https://edint.es/def/cubo-gasto-comercial> widoco:vocabularyLabel [
    widoco:vocabularyIRI <http://vocab.linkeddata.es/datosabiertos/def/measure> ;
    rdfs:label "Medidas EDINT"@es , "EDINT Measures"@en ] .
<https://edint.es/def/cubo-gasto-comercial> widoco:vocabularyLabel [
    widoco:vocabularyIRI <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio> ;
    rdfs:label "Territorio (esadm)"@es , "Territory (esadm)"@en ] .
<https://edint.es/def/cubo-gasto-comercial> widoco:vocabularyLabel [
    widoco:vocabularyIRI <http://www.w3.org/2006/time> ;
    rdfs:label "OWL-Time"@es , "OWL-Time"@en ] .
