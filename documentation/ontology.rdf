    <rdf:Description rdf:about="http://vocab.linkeddata.es/datosabiertos/def/dimension#economicActivity">
        <rdfs:comment xml:lang="es">Actividad económica representada mediante una clasificación controlada como la CNAE.</rdfs:comment>
