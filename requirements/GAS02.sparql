# GAS02: ¿Cuál es el gasto comercial total por región administrativa en un periodo concreto?

PREFIX edintgast: <https://edint.es/def/cubo-gasto-comercial#>
PREFIX qb: <http://purl.org/linked-data/cube#>
PREFIX edintdimension: <https://edint.es/def/dimension#>
PREFIX edintmeasure: <https://edint.es/def/measure#>

SELECT ?region (SUM(?amount) AS ?totalExpenditure)
WHERE {
  ?obs a qb:Observation ;
       qb:dataSet edintgast: ;
       edintdimension:refAdminRegion ?region ;
       edintdimension:refPeriod ?period ;
       edintmeasure:expenditureAmount ?amount .

  FILTER(?period = <URI_PERIODO>)
}
GROUP BY ?region
ORDER BY DESC(?totalExpenditure)