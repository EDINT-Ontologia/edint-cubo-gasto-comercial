# Ejemplo de observación del cubo de gasto comercial utilizado en la documentación.
# Documentación: documentation/sections/description-es.html (Ejemplo 1) y
#                documentation/sections/description-en.html (Example 1).

@prefix edintgast:      <https://edint.es/def/cubo-gasto-comercial#> .
@prefix edintdimension: <http://vocab.linkeddata.es/datosabiertos/def/dimension#> .
@prefix edintmeasure:   <http://vocab.linkeddata.es/datosabiertos/def/measure#> .
@prefix qb:             <http://purl.org/linked-data/cube#> .
@prefix rdfs:           <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time:           <http://www.w3.org/2006/time#> .
@prefix xsd:            <http://www.w3.org/2001/XMLSchema#> .

@prefix ex:            <http://example.org/recurso/> .


# 1) Reutilización del conjunto de datos y de la estructura de datos
ex:DatasetGastoComercial a qb:DataSet ;
    qb:structure edintgast:dsd .

# 2) Periodo de referencia: la dimensión refPeriod tiene como rango time:Interval,
#    por lo que se representa mediante una instancia explícita de intervalo temporal.
ex:interval-2025-01
    a time:Interval ;
    rdfs:label "January 2025"@en ,
               "Enero de 2025"@es .

# 3) Observación del conjunto de datos
ex:obs001
    a qb:Observation ;
    qb:dataSet edintgast: ;
    edintdimension:refAdminRegion ex:zaragoza ;
    edintdimension:sector <https://datos.gob.es/kos/sector-publico/sector#comercio> ;
    edintdimension:economicActivity <http://lod.ine.es/kos/cnae/CNAE-2025/G> ;
    edintdimension:refPeriod ex:interval-2025-01 ;
    edintdimension:nationality "Spanish"^^xsd:string ;
    edintmeasure:expenditureAmount "125430.75"^^xsd:decimal .
